{
  "manifest_version": 3,
  "name": "TempMail for temp.tf",
  "version": "1.1.0",
  "description": "Persistent disposable email with inbox, notifications, OTP detection and one-click form autofill. Powered by the temp.tf API.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://temp.tf/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TempMail",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "autofill-form": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Autofill the current page's form with the temp email"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Open TempMail"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}