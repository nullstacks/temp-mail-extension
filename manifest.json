{
  "manifest_version": 3,
  "name": "Nullstacks Temp Mail",
  "version": "1.0.0",
  "description": "Disposable email powered by temp.tf \u2014 one address that stays constant until you change it. One-click form autofill, inbox with OTP copy, HTML viewer, attachments.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "clipboardWrite",
    "downloads"
  ],
  "host_permissions": [
    "https://temp.tf/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Nullstacks Temp Mail (temp.tf)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "fill-email": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Fill email field on page with temp mail address"
    }
  }
}